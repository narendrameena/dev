# Ignore everything
*

# Allow folder structure
!*/

# Allow all notebooks in scripts/hanifa/
!scripts/hanifa/*.ipynb
!scripts/Kidney_SC/*.ipynb
!scripts/hanifa and Pysrosis/*.ipynb
!scripts/Kidney_ST/*.ipynb
!scripts/Kidney_image_ST/*.ipynb

# Allow README
!README.md

# Figure set: analysis scripts, rendered figures and the source data behind
# every panel. Deliberately excludes Figures/source_data/derived/ (large,
# regenerable by 00_extract_panel.py) and the refGene annotation (downloadable).
!Figures/scripts/*.py
!Figures/figures/*.png
!Figures/figures/*.pdf
!Figures/figures/*.svg
!Figures/figures/*.txt
!Figures/source_data/*.csv
Figures/source_data/derived/
Figures/source_data/*.gz